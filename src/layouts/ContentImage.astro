---
import type { PortableTextImageBlock } from 'emdash'
import ResponsiveImage from './ResponsiveImage.astro'

interface Props {
  node: PortableTextImageBlock & {
    blurhash?: string
    dominantColor?: string
  }
}

const { node } = Astro.props
const src = node.asset.url || `/_emdash/api/media/file/${node.asset._ref}`
const sizes = '(min-width: 1024px) 782px, (min-width: 768px) calc(83.33vw - 4.5rem), calc(100vw - 3rem)'
---

<figure class='emdash-image'>
  <ResponsiveImage
    src={src}
    alt={node.alt || ''}
    sourceWidth={node.width}
    sourceHeight={node.height}
    maxWidth={node.displayWidth || 782}
    sizes={sizes}
    blurhash={node.blurhash}
    dominantColor={node.dominantColor}
  />
  {node.caption && <figcaption>{node.caption}</figcaption>}
</figure>

<style>
  .emdash-image {
    margin: 1.5rem 0;
  }
  .emdash-image figcaption {
    margin-top: 0.5rem;
    color: #666;
    font-size: 0.875rem;
    text-align: center;
  }
</style>
