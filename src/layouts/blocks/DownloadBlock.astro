---
import { sanitizeHref } from 'emdash'
import type { BlockComponentProps } from 'emdash/ui'
import type { PageLayoutBlock } from '../../../emdash-env'
import { fileUrl } from '../../lib/cms'

type DownloadBlockValue = Extract<PageLayoutBlock, { _type: 'download' }>
type Props = BlockComponentProps<DownloadBlockValue>

const { value } = Astro.props
const href = sanitizeHref(fileUrl(value.file))
---

<section class='not-prose my-2' aria-labelledby={`download-${value._key}`}>
  <div class='min-w-0'>
    <h2 id={`download-${value._key}`} class='text-base font-semibold leading-tight'>{value.title}</h2>
    {value.description && <p class='mt-1 text-sm text-gray-700'>{value.description}</p>}
    {href && href !== '#' ? (
      <a
        href={href}
        download={value.file.filename || true}
        class='mt-1 inline-flex items-center gap-2 rounded-lg bg-gray-100 px-4 py-2 hover:bg-gray-200 transition-colors'
      >
        {value.file.filename || value.title} <span aria-hidden='true'>📄</span>
      </a>
    ) : (
      <p role='alert' class='mt-1 text-sm text-red-700'>Dit bestand is momenteel niet beschikbaar.</p>
    )}
  </div>
</section>
