---
import '../styles/global.css'
import Footer from '../layouts/Footer.astro'
import Header from '../layouts/Header.astro'
import { Image } from 'astro:assets'
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui'
import { createPublicPageContext } from 'emdash/page'
import logo from '../assets/logo.jpg'
import anbi from '../assets/anbi.svg'

interface Props {
  title: string
  pageTitle?: string | null
  description?: string
  keywords?: string[]
  ogImage?: string | null
  canonical?: string | null
  robots?: string | null
  content?: { collection: string; id: string; slug?: string | null }
}

const { title, pageTitle, description, keywords, ogImage, canonical, robots, content } = Astro.props
const documentTitle = title.includes('SKPD') ? title : `${title} | SKPD`
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString()
const defaultDescription = 'Stichting Keramiek Promotie Delft - bevorderen van de belangstelling voor hedendaagse keramiek'
const metaDescription = description || defaultDescription
const page = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: 'website',
  title: documentTitle,
  pageTitle: pageTitle || title,
  description: metaDescription,
  canonical: canonicalURL,
  image: ogImage,
  content,
  siteName: 'SKPD',
})
---

<!doctype html>
<html lang='nl'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' href='/favicon.ico' sizes='32x32' />
    <link rel='canonical' href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{documentTitle}</title>
    <meta name='title' content={documentTitle} />
    <meta name='description' content={metaDescription} />
    {robots && <meta name='robots' content={robots} />}
    {keywords && <meta name='keywords' content={keywords.join(', ')} />}

    <!-- Open Graph / Facebook -->
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={pageTitle || documentTitle} />
    <meta property='og:description' content={metaDescription} />
    {ogImage && <meta property='og:image' content={ogImage} />}
    <meta property='og:locale' content='nl_NL' />
    <meta property='og:site_name' content='SKPD' />

    <!-- Twitter -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:url' content={canonicalURL} />
    <meta name='twitter:title' content={pageTitle || documentTitle} />
    <meta name='twitter:description' content={metaDescription} />
    {ogImage && <meta name='twitter:image' content={ogImage} />}
    <EmDashHead page={page} />

  </head>
  <body class='w-full min-h-screen max-w-screen-lg mx-auto px-6 flex flex-col bg-white'>
    <EmDashBodyStart page={page} />
    <Header />

    <div class='flex flex-row flex-wrap justify-center md:flex md:flex-row'>
      <main class='w-full md:order-2 md:w-5/6 md:px-4 prose max-w-none'>
        <slot />
      </main>

      <div id='left-sidebar' class='w-1/2 pr-2 md:order-1 md:w-1/6 md:px-2'>
        <Image 
          src={logo} 
          alt='SKPD logo' 
          width={200}
          widths={[120, 200]}
          sizes='(min-width: 768px) 200px, 50vw'
          quality={80}
          format='webp'
          loading='eager'
        />
        <p class='text-xs italic pt-2 pb-4 text-gray-600'>
          Stichting Keramiek Promotie Delft heeft ten doel het bevorderen van de belangstelling voor
          en de bekendheid met de nationale en internationale hedendaagse keramiek.
        </p>
        <img
          src={anbi.src}
          alt='ANBI logo'
          width={80}
          height={64}
          loading='eager'
        />
      </div>
    </div>

    <Footer />
    <EmDashBodyEnd page={page} />
  </body>
</html>

<style is:global>
  /* Smooth transitions */
  html {
    scroll-behavior: smooth;
  }

  /* Link styles */
  a {
    color: #003a97;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover {
    color: #c63;
    text-decoration: underline;
  }

</style>
