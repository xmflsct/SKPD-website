---
import { Picture } from 'astro:assets'
import {
  canonicalSiteUrl,
  responsiveImageDimensions,
  responsiveImageWidths,
} from '../lib/responsiveImages.mjs'

interface Props {
  src: string
  alt: string
  sourceWidth?: number
  sourceHeight?: number
  maxWidth?: number
  sizes: string
  priority?: boolean
  class?: string
  blurhash?: string
  dominantColor?: string
}

const {
  src,
  alt,
  sourceWidth,
  sourceHeight,
  maxWidth = 782,
  sizes,
  priority = false,
  class: className,
  blurhash,
  dominantColor,
} = Astro.props
const hasDimensions = sourceWidth && sourceHeight
const dimensions = hasDimensions
  ? responsiveImageDimensions(sourceWidth, sourceHeight, maxWidth)
  : undefined
const widths = dimensions ? responsiveImageWidths(sourceWidth, dimensions.width) : undefined
const resolvedSrc = canonicalSiteUrl(src, Astro.site?.origin || Astro.url.origin) || src
let placeholderStyle: string | undefined
if (blurhash) {
  const { blurhashToImageCssString } = await import('@unpic/placeholder')
  placeholderStyle = blurhashToImageCssString(blurhash)
} else if (dominantColor) {
  placeholderStyle = `background-color: ${dominantColor};`
}
---

{
  dimensions ? (
    <Picture
      src={resolvedSrc}
      alt={alt}
      width={dimensions.width}
      height={dimensions.height}
      widths={widths}
      sizes={sizes}
      formats={['avif']}
      fallbackFormat='webp'
      quality={80}
      priority={priority}
      loading={priority ? 'eager' : 'lazy'}
      decoding='async'
      class={className}
      style={placeholderStyle}
    />
  ) : (
    <img
      src={resolvedSrc}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding='async'
      class={className}
    />
  )
}
