---
import { sanitizeHref } from 'emdash'

interface Props {
  node: {
    url?: string
    id?: string
    filename?: string
    label?: string
  }
}

const { node } = Astro.props
const url = sanitizeHref(node.url || node.id)
---

{
  url && (
    <a
      href={url}
      target='_blank'
      rel='noopener noreferrer'
      class='underline decoration-1 underline-offset-2 hover:no-underline'
    >
      {node.label || node.filename || 'Download bestand'}
    </a>
  )
}
