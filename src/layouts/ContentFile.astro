---
import { sanitizeHref } from 'emdash'

interface Props {
  node: {
    url?: string
    id?: string
    filename?: string
    label?: string
  }
}

const { node } = Astro.props
const url = sanitizeHref(node.url || node.id)
---

<p>
  <a
    href={url}
    target='_blank'
    rel='noopener noreferrer'
    class='inline-flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors'
  >
    {node.label || node.filename || 'Download'} <span>📄</span>
  </a>
</p>
