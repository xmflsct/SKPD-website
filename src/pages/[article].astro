---
import { decodeSlug, getEmDashEntry, getSeoMeta } from 'emdash'
import Layout from '../layouts/Layout.astro'
import Event from '../layouts/Event.astro'
import { eventDescription, mediaUrl, type EventData } from '../lib/cms'

const slug = decodeSlug(Astro.params.article)
if (!slug) return Astro.rewrite('/404')

const { entry: event, error } = await getEmDashEntry<'events', EventData>('events', slug)
if (error && error.name !== 'LiveEntryNotFoundError') throw error
if (!event) return Astro.rewrite('/404')

const seo = getSeoMeta(event, {
  siteTitle: 'SKPD',
  siteUrl: 'https://www.skpd.nl',
  path: `/${slug}`,
  defaultDescription: eventDescription(event.data.content),
  defaultOgImage: mediaUrl(event.data.featured_image, Astro.site?.origin || Astro.url.origin),
})
---

<Layout
  title={seo.title}
  pageTitle={seo.title}
  description={seo.description || undefined}
  keywords={['SKPD', 'keramiek', event.data.title]}
  canonical={seo.canonical}
  ogImage={seo.ogImage}
  robots={seo.robots}
  content={{ collection: 'events', id: event.data.id, slug }}
>
  <Event event={event} />
</Layout>
