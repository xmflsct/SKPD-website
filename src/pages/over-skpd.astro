---
import { getEmDashEntry, getSeoMeta } from 'emdash'
import Layout from '../layouts/Layout.astro'
import PageBlocks from '../layouts/PageBlocks.astro'
import type { PageData } from '../lib/cms'

const { entry: page, error, cacheHint } = await getEmDashEntry<'pages', PageData>('pages', 'over-skpd')
Astro.cache.set(cacheHint)
if (error) throw error
if (!page) return Astro.rewrite('/404')

const seo = getSeoMeta(page, {
  siteTitle: 'SKPD',
  siteUrl: 'https://www.skpd.nl',
  path: '/over-skpd',
})
---

<Layout
  title={seo.title}
  pageTitle={seo.title}
  description={seo.description || 'Leer meer over Stichting Keramiek Promotie Delft, onze missie en activiteiten ter bevordering van hedendaagse keramiek.'}
  keywords={['SKPD', 'over ons', 'keramiek', 'Delft', 'stichting']}
  canonical={seo.canonical}
  ogImage={seo.ogImage}
  robots={seo.robots}
  content={{ collection: 'pages', id: page.data.id, slug: 'over-skpd' }}
>
  <article>
    <h1 class='text-2xl md:text-3xl font-bold mb-6' {...page.edit.title}>{page.data.title}</h1>
    <PageBlocks value={page.data.layout ?? []} />
  </article>
</Layout>
