---
import { getEmDashCollection, getMenuWithCacheHint } from 'emdash'
import Layout from '../layouts/Layout.astro'
import EventPreview from '../layouts/EventPreview.astro'
import type { EventData } from '../lib/cms'

const [eventsResult, menuResult] = await Promise.all([
  getEmDashCollection<'events', EventData>('events', {
    status: 'published',
    orderBy: { end_date: 'desc' },
  }),
  getMenuWithCacheHint('current-events'),
])
const { entries: allEvents, error, cacheHint: eventsCacheHint } = eventsResult
const { data: menu, cacheHint: menuCacheHint } = menuResult
Astro.cache.set(eventsCacheHint)
Astro.cache.set(menuCacheHint)
if (error) throw error

const currentUrls = new Set(menu?.items.map(item => item.url.replace(/\/$/, '')) ?? [])
const events = allEvents.filter(event => !currentUrls.has(`/${event.id}`))
---

<Layout
  title='Archief'
  keywords={['SKPD', 'archief', 'keramiek', 'evenementen']}
  description='Bekijk het archief van alle SKPD keramiek evenementen door de jaren heen.'
>
  <h1 class='text-2xl md:text-3xl font-bold mb-6'>Archief</h1>
  <p class='text-gray-600 mb-6'>
    Bekijk hier alle voorgaande evenementen van Stichting Keramiek Promotie Delft.
  </p>
  <div class='space-y-2'>
    {events.map(event => <EventPreview event={event} />)}
  </div>
</Layout>
