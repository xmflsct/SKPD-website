---
import { getEmDashCollection } from 'emdash'
import Layout from '../layouts/Layout.astro'
import Event from '../layouts/Event.astro'
import { mediaUrl, type EventData } from '../lib/cms'

const { entries, error } = await getEmDashCollection<'events', EventData>('events', {
  status: 'published',
  orderBy: { end_date: 'desc' },
  limit: 1,
})
if (error) throw error

const event = entries[0]
---

<Layout
  title='Home'
  keywords={['SKPD', 'keramiek', 'Delft', 'Terra Delft', 'hedendaagse keramiek']}
  description='Stichting Keramiek Promotie Delft bevordert de belangstelling voor nationale en internationale hedendaagse keramiek.'
  ogImage={mediaUrl(event?.data.featured_image, Astro.site?.origin || Astro.url.origin)}
  content={event ? { collection: 'events', id: event.data.id, slug: event.id } : undefined}
>
  {event ? <Event event={event} /> : <p>Er zijn momenteel geen evenementen gepubliceerd.</p>}
</Layout>
