{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skpd-website",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "www.skpd.nl",
			"custom_domain": true
		},
		{
			"pattern": "skpd.nl",
			"custom_domain": true
		}
	],
	"cache": {
		"enabled": true,
		"cross_version_cache": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skpd-website",
			"database_id": "880e547d-f364-4a9f-ab3f-900bcd3538d0"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "skpd-website-media"
		}
	]
}
