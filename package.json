{
  "name": "skpd-website",
  "type": "module",
  "emdash": {
    "seed": ".emdash/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "CLOUDFLARE_ENV=production astro build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview astro build && wrangler deploy",
    "typecheck": "astro check",
    "test": "node --test",
    "contentful:import": "node --env-file-if-exists=.env scripts/import-contentful.mjs",
    "emdash:init": "emdash init",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/react": "5.0.7",
    "@emdash-cms/cloudflare": "0.31.1",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^6.4.6",
    "emdash": "0.31.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260730.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "24.10.1",
    "sharp": "0.35.3",
    "wrangler": "4.116.0"
  }
}
