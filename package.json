{
  "name": "skpd-website",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "emdash": {
    "seed": ".emdash/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "npm exec --yes --package=npm@11.6.2 -- npm ci --progress=false && SKPD_CLOUDFLARE_DEPLOYMENT=1 npm run build",
    "preview": "astro preview",
    "deploy": "SKPD_CLOUDFLARE_DEPLOYMENT=1 npm run build && wrangler deploy",
    "upload-version": "wrangler versions upload --preview-alias preview --tag \"${WORKERS_CI_COMMIT_SHA:-$(git rev-parse HEAD)}\"",
    "typecheck": "astro check",
    "test": "node --test",
    "e2e": "node scripts/e2e.mjs",
    "contentful:import": "node --env-file-if-exists=.env scripts/import-contentful.mjs",
    "pages:apply-blocks-schema": "node --env-file-if-exists=.env scripts/apply-page-blocks-schema.mjs",
    "pages:migrate-blocks": "node --env-file-if-exists=.env scripts/migrate-page-blocks.mjs",
    "emdash:init": "emdash init",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "7.0.0",
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/cloudflare": "1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "emdash": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260928.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "24.19.0",
    "sharp": "0.35.5",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  }
}
